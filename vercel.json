    { "source": "/04-workshop/:path*", "destination": "/handbook/04-workshop/:path*", "permanent": true },
    { "source": "/05-camp", "destination": "/handbook/05-camp/", "permanent": true },
    { "source": "/05-camp/", "destination": "/handbook/05-camp/", "permanent": true },
    { "source": "/05-camp/:path*", "destination": "/handbook/05-camp/:path*", "permanent": true }
  ]
