---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHeroMotto from '../components/HomeHeroMotto.astro';
import HomeHeroTitle from '../components/HomeHeroTitle.astro';
import CampGallery from '../components/site/CampGallery.astro';
import SectionHead from '../components/site/SectionHead.astro';
import {
	site,
	programs,
	culturalPlain,
	campLocations,
	campPhotos,
	testimonials,
	advantages,
	contact,
} from '../data/site';
---

<BaseLayout
	title={site.name}
	description="知合 NEXUS 是致力于在中国文化平原地区为青年人搭建思辨、讨论、共学社群的非营利教育项目。了解读书营、圆桌共学、团队与参与方式。"
	splash
>
	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: '知合 NEXUS',
		alternateName: ['知合Nexus', '知合 Nexus', 'Zhihe Nexus'],
		url: 'https://zhihenexus.org',
		logo: 'https://zhihenexus.org/images/nexus-logo.png',
		description: site.description,
		email: contact.email,
		foundingDate: String(site.yearFounded),
		slogan: site.motto,
	})} />
	<section class="nexus-hero nexus-hero--site" aria-label="知合 Nexus">
		<HomeHeroMotto />

		<div class="nexus-hero__inner">
			<div class="nexus-hero__content">
				<HomeHeroTitle />

				<div class="nexus-hero__mission-grid">
					<div class="nexus-hero__mission-item">
						<p class="nexus-hero__mission-label">使命</p>
						<p class="nexus-hero__mission-text">{site.description}</p>
					</div>
					<div class="nexus-hero__mission-item">
						<p class="nexus-hero__mission-label">愿景</p>
						<p class="nexus-hero__mission-text">{site.vision}</p>
					</div>
				</div>

				<div class="nexus-hero__actions">
					<a class="nexus-hero__cta" href="/programs/">了解读书营</a>
					<a class="nexus-hero__cta nexus-hero__cta--ghost" href="/philosophy/">理念与方法</a>
					<a class="nexus-hero__cta nexus-hero__cta--ghost" href="/handbook/">领读人手册</a>
				</div>
			</div>
		</div>
	</section>

	<div class="site-docs">
		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead
					eyebrow="Programs"
					title="知合主要项目"
					intro="以圆桌·博雅为方法，在暑期、冬季与线上持续展开共学实践。"
				/>

				<div class="site-card-grid site-card-grid--cols-3" data-reveal-stagger>
					{
						programs.map((item) => (
							<article class="site-card">
								<p class="site-card__tag">{item.tag}</p>
								<h3 class="site-card__title">{item.title}</h3>
								<p class="site-card__text">{item.description}</p>
							</article>
						))
					}
				</div>
				<div data-reveal="fade">
					<CampGallery photos={campPhotos} compact />
				</div>
				<div class="nexus-hero__actions site-section__actions" data-reveal="fade">
					<a class="nexus-hero__cta" href="/programs/">项目详情与时间线</a>
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow="Cultural Plain" title="落点：文化平原" intro={culturalPlain.definition} />
				<div class="location-tags" data-reveal-stagger>
					{campLocations.map((city) => <span class="location-tag">{city}</span>)}
				</div>
				<p class="location-note" data-reveal="fade">2024 年以来的知合营地点</p>
			</div>
		</section>

		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead
					eyebrow="Voices"
					title="共读人反馈"
					intro="每年，我们读书营的反馈都超出了预期，这也印证了我们的定位是准确的。"
				/>
				<div class="quote-grid" data-reveal-stagger>
					{
						testimonials.map((item) => (
							<blockquote class="quote-card">
								<p class="quote-card__text">「{item.quote}」</p>
								<footer class="quote-card__author">
									—— {item.author}（{item.role}）
								</footer>
							</blockquote>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow="Strength" title="独特优势" />
				<div class="site-card-grid site-card-grid--cols-3" data-reveal-stagger>
					{
						advantages.map((item) => (
							<article class="site-card">
								<h3 class="site-card__title">{item.title}</h3>
								<p class="site-card__text">{item.text}</p>
							</article>
						))
					}
				</div>
				<div class="nexus-hero__actions site-section__actions" data-reveal="fade">
					<a class="nexus-hero__cta" href="/join/">参与我们</a>
				</div>
			</div>
		</section>

		<section class="site-closing">
			<div data-reveal-block>
				<p class="site-closing__text" data-reveal-item>
					<span class="reveal-line__inner">共赴平原</span>
				</p>
			</div>
			<div class="site-closing__contact" data-reveal-stagger>
				<div class="site-closing__item">
					<p class="site-closing__label">咨询邮箱</p>
					<a class="site-closing__link" href={`mailto:${contact.email}`}>{contact.email}</a>
				</div>
				<div class="site-closing__item">
					<p class="site-closing__label">近期活动</p>
					<a
						class="site-closing__link"
						href={contact.wechatArticle.href}
						target="_blank"
						rel="noopener noreferrer">{contact.wechatArticle.label}</a
					>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
