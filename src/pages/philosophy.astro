---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import SectionHead from '../components/site/SectionHead.astro';
import { liberalEducation, roundtable } from '../data/site';
---

<BaseLayout
	title="理念与方法"
	description="知合 NEXUS 的博雅教育理念与圆桌共学方法。"
	currentPath="/philosophy/"
>
	<PageHero eyebrow="Philosophy" title="理念与方法" lede="圆桌 · 博雅" />

	<div class="site-docs">
		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow="Liberal Education" title="博雅教育" intro={liberalEducation.intro} />

				<div class="site-card-grid site-card-grid--cols-3">
					{
						liberalEducation.pillars.map((item) => (
							<article class="site-card">
								<h3 class="site-card__title">{item.title}</h3>
								<p class="site-card__text">{item.text}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow="Roundtable" title="圆桌作为一种方法" intro={roundtable.philosophy} />

				<div class="site-card-grid site-card-grid--cols-2">
					{
						roundtable.features.map((item) => (
							<article class="site-card">
								<p class="site-card__text">{item}</p>
							</article>
						))
					}
				</div>

				<p class="site-section__intro site-section__intro--spaced">{roundtable.practice}</p>
			</div>
		</section>
	</div>
</BaseLayout>
