---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import CampGallery from '../../components/site/CampGallery.astro';
import { campPhotos, facilitatorRecruitment, site } from '../../data/site';

const { application, roles, process, sampleSyllabi, wechatArticle, assistantNote } =
	facilitatorRecruitment;
---

<BaseLayout
	title="领读人招募"
	description="2026 暑期知合圆桌领读人招募——营地信息、角色要求、报名与录取流程。"
	currentPath="/join/facilitator/"
>
	<PageHero
		eyebrow="Facilitator Recruitment"
		title="领读人招募"
		lede="设计并带领一门原创圆桌课程，与共读人一起在文化平原展开思辨与共学。"
	/>

	<div class="site-docs">
		<section class="site-section">
			<div class="site-page-inner site-page-inner--wide">
				<div class="recruit-banner">
					<p class="recruit-banner__text">
						报名截止：<strong>{application.deadline}</strong>
					</p>
					<div class="nexus-hero__actions site-section__actions recruit-banner__actions">
						<a
							class="nexus-hero__cta"
							href={wechatArticle.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							{wechatArticle.label}
						</a>
						<a class="nexus-hero__cta nexus-hero__cta--ghost" href="/handbook/">
							阅读领读人手册
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow="01" title="申请信息" />
				<div class="site-card recruit-info">
					<dl class="recruit-info__list">
						<div class="recruit-info__row">
							<dt>营地信息</dt>
							<dd>
								<ul class="feature-list">
									{
										application.camps.map((camp) => (
											<li>
												{camp.location}（{camp.dates}）
											</li>
										))
									}
								</ul>
							</dd>
						</div>
						<div class="recruit-info__row">
							<dt>报名资质</dt>
							<dd>{application.qualification}</dd>
						</div>
						<div class="recruit-info__row">
							<dt>截止时间</dt>
							<dd>{application.deadline}</dd>
						</div>
						<div class="recruit-info__row">
							<dt>招募模式</dt>
							<dd>{application.mode}</dd>
						</div>
						<div class="recruit-info__row">
							<dt>重要提示</dt>
							<dd>{application.support}</dd>
						</div>
						<div class="recruit-info__row">
							<dt>报名方式</dt>
							<dd>
								{application.method}
								<a href={wechatArticle.href} target="_blank" rel="noopener noreferrer">
									前往微信公众号报名
								</a>
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow="02" title="我们在找谁" intro="知合圆桌领读人" />
				<p class="recruit-lede">
					在知合圆桌中，每个领读人将扮演三个重要的角色：课程设置者、讨论带领者、知识传播者。
				</p>
				<div class="site-card-grid site-card-grid--cols-3">
					{
						roles.map((role) => (
							<article class="site-card">
								<h3 class="site-card__title">{role.title}</h3>
								<p class="site-card__text">{role.intro}</p>
								{role.points.length > 0 && (
									<ul class="feature-list">
										{role.points.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								)}
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow="03" title="暑期营地介绍" intro="往期营地现场" />
				<CampGallery photos={campPhotos} />
			</div>
		</section>

		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow="04" title="报名与录取流程" />
				<div class="recruit-process">
					{
						process.map((item, index) => (
							<article class="site-card recruit-process__item">
								<p class="recruit-process__step">
									<span class="recruit-process__index">{String(index + 1).padStart(2, '0')}</span>
									{item.step}
								</p>
								<p class="recruit-process__timing">{item.timing}</p>
								<p class="site-card__text">{item.description}</p>
								{item.points.length > 0 && (
									<ul class="feature-list">
										{item.points.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								)}
								{item.note && <p class="recruit-process__note">{item.note}</p>}
							</article>
						))
					}
				</div>

				<div class="site-card recruit-resource">
					<h3 class="site-card__title">{sampleSyllabi.label}</h3>
					<p class="site-card__text">
						<a href={sampleSyllabi.href} target="_blank" rel="noopener noreferrer">
							百度网盘下载
						</a>
						· 提取码：{sampleSyllabi.password}
					</p>
				</div>

				<div class="site-card recruit-resource">
					<h3 class="site-card__title">咨询联系</h3>
					<p class="site-card__text">{assistantNote}</p>
				</div>

				<div class="dual-panel recruit-mission">
					<div class="dual-panel__item">
						<p class="dual-panel__label">使命</p>
						<p>{site.description}</p>
					</div>
					<div class="dual-panel__item">
						<p class="dual-panel__label">愿景</p>
						<p>{site.vision}</p>
					</div>
				</div>

				<div class="nexus-hero__actions site-section__actions">
					<a
						class="nexus-hero__cta"
						href={wechatArticle.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{wechatArticle.label}
					</a>
					<a class="nexus-hero__cta nexus-hero__cta--ghost" href="/join/">返回参与页</a>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.site-page-inner--wide {
		max-width: var(--content-wide);
	}

	.recruit-banner {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem 1.75rem;
		border: 1px solid var(--nexus-blue-mist);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.72);
	}

	.recruit-banner__text {
		margin: 0;
		font-size: 1rem;
		color: var(--nexus-ink-soft);
		line-height: 1.7;
	}

	.recruit-banner__actions {
		margin-top: 0;
	}

	.recruit-lede {
		max-width: var(--content-wide);
		margin: -0.5rem 0 1.75rem;
		color: var(--nexus-ink-soft);
		line-height: var(--line-prose);
	}

	.recruit-info__list {
		margin: 0;
		display: grid;
		gap: 1.25rem;
	}

	.recruit-info__row {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 0.75rem 1.25rem;
	}

	.recruit-info__row dt {
		margin: 0;
		font-weight: 700;
		color: var(--nexus-blue);
		font-size: 0.92rem;
	}

	.recruit-info__row dd {
		margin: 0;
		color: var(--nexus-ink-soft);
		line-height: 1.75;
	}

	.recruit-info__row dd .feature-list {
		margin-top: 0;
	}

	.recruit-process {
		display: grid;
		gap: 1.25rem;
	}

	.recruit-process__item {
		display: grid;
		gap: 0.65rem;
	}

	.recruit-process__step {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		font-family: var(--nexus-font-display);
		font-size: 1.15rem;
		color: var(--nexus-blue);
		letter-spacing: 0.04em;
	}

	.recruit-process__index {
		font-family: var(--nexus-font-body);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #718096;
	}

	.recruit-process__timing {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--nexus-ink);
	}

	.recruit-process__note {
		margin: 0.25rem 0 0;
		padding: 0.85rem 1rem;
		border-left: 3px solid var(--nexus-blue-pale);
		background: rgba(232, 237, 245, 0.45);
		font-size: 0.9rem;
		color: var(--nexus-ink-soft);
		line-height: 1.7;
	}

	.recruit-resource {
		margin-top: 1.25rem;
	}

	.recruit-mission {
		margin-top: 1.75rem;
	}

	@media (max-width: 720px) {
		.recruit-info__row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}

		.recruit-banner {
			padding: 1.25rem 1.15rem;
		}
	}
</style>
