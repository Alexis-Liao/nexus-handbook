---
import MemoryArticlePage from '../../../../views/MemoryArticlePage.astro';
import { getAllCampMemorySlugs, getCampMemory } from '../../../../data/campMemories';

export function getStaticPaths() {
	return getAllCampMemorySlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const locale = 'en';
const article = getCampMemory(slug!, locale);

if (!article) {
	return Astro.redirect('/en/programs/');
}
---

<MemoryArticlePage locale={locale} article={article} />
