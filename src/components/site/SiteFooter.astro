---
import { getSiteData } from '../../data/site';
import { getUi } from '../../i18n/ui';
import { getLogoAlt, localizePath, type Locale } from '../../i18n/utils';
import { LOGO_PATH } from '../../consts';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { contact, footerColumns, site, socialLinks } = getSiteData(locale);
const t = getUi(locale);

const wechat = socialLinks.find((item) => item.id === 'wechat');
const xiaohongshu = socialLinks.find((item) => item.id === 'xiaohongshu');
---

<footer class="site-footer">
	<div class="site-page-inner site-footer__inner">
		<div class="site-footer__grid">
			<div class="site-footer__brand">
				<a class="site-footer__logo-link" href={localizePath('/', locale)} aria-label={t.footer.backHome}>
					<img src={LOGO_PATH} alt={getLogoAlt(locale)} class="site-footer__logo" />
				</a>

				<div class="site-footer__media">
					{
						wechat && 'qrcode' in wechat && (
							<figure class="site-footer__media-card site-footer__qrcode">
								<img
									src={wechat.qrcode}
									alt={`${wechat.label}`}
									width="96"
									height="96"
									loading="lazy"
								/>
								<figcaption>{t.footer.scanWechat}</figcaption>
							</figure>
						)
					}
				</div>

				<div class="site-footer__contact">
					<p>
						<span class="site-footer__contact-label">{t.footer.emailLabel}</span>
						<a href={`mailto:${contact.email}`}>{contact.email}</a>
					</p>
					{
						wechat && (
							<p>
								<span class="site-footer__contact-label">{wechat.label}：</span>
								{wechat.name}
							</p>
						)
					}
					{
						xiaohongshu && (
							<p>
								<span class="site-footer__contact-label">{xiaohongshu.label}：</span>
								{xiaohongshu.name}
							</p>
						)
					}
				</div>
			</div>

			{
				footerColumns.map((column) => (
					<div class="site-footer__column">
						<h2 class="site-footer__column-title">{column.title}</h2>
						<ul class="site-footer__column-links">
							{
								column.links.map((link) => (
									<li>
										<a
											href={localizePath(link.href, locale)}
											{'external' in link && link.external
												? { target: '_blank', rel: 'noopener noreferrer' }
												: {}}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				))
			}
		</div>

		<p class="site-footer__meta">
			© {new Date().getFullYear()} {site.name} · {t.footer.nonprofit} · {t.footer.founded} {site.yearFounded}
		</p>
	</div>
</footer>
