---
import { contact, footerColumns, site, socialLinks } from '../../data/site';
import { LOGO_PATH, LOGO_ALT } from '../../consts';

const wechat = socialLinks.find((item) => item.id === 'wechat');
const xiaohongshu = socialLinks.find((item) => item.id === 'xiaohongshu');
---

<footer class="site-footer" transition:persist="site-footer">
	<div class="site-page-inner site-footer__inner">
		<div class="site-footer__grid">
			<div class="site-footer__brand">
				<a class="site-footer__logo-link" href="/" aria-label="返回首页">
					<img src={LOGO_PATH} alt={LOGO_ALT} class="site-footer__logo" />
				</a>

				<div class="site-footer__media">
					{
						wechat && 'qrcode' in wechat && (
							<figure class="site-footer__media-card site-footer__qrcode">
								<img
									src={wechat.qrcode}
									alt={`${wechat.label}二维码`}
									width="96"
									height="96"
									loading="lazy"
								/>
								<figcaption>扫码关注公众号</figcaption>
							</figure>
						)
					}
				</div>

				<div class="site-footer__contact">
					<p>
						<span class="site-footer__contact-label">电子邮箱：</span>
						<a href={`mailto:${contact.email}`}>{contact.email}</a>
					</p>
					{
						wechat && (
							<p>
								<span class="site-footer__contact-label">{wechat.label}：</span>
								{wechat.name}
							</p>
						)
					}
					{
						xiaohongshu && (
							<p>
								<span class="site-footer__contact-label">{xiaohongshu.label}：</span>
								{xiaohongshu.name}
							</p>
						)
					}
				</div>
			</div>

			{
				footerColumns.map((column) => (
					<div class="site-footer__column">
						<h2 class="site-footer__column-title">{column.title}</h2>
						<ul class="site-footer__column-links">
							{
								column.links.map((link) => (
									<li>
										<a
											href={link.href}
											{'external' in link && link.external
												? { target: '_blank', rel: 'noopener noreferrer' }
												: {}}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				))
			}
		</div>

		<p class="site-footer__meta">
			© {new Date().getFullYear()} {site.name} · 非营利性创新教育项目 · 创立于 {site.yearFounded}
		</p>
	</div>
</footer>
