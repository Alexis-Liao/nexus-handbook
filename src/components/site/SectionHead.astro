---
interface Props {
	eyebrow: string;
	title: string;
	intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="site-section__lead" data-reveal-block>
	<p class="site-section__eyebrow" data-reveal-item>{eyebrow}</p>
	<h2 class="site-section__title" data-reveal-item>{title}</h2>
	{intro && <p class="site-section__intro" data-reveal-item>{intro}</p>}
</div>
