---
import type { campPhotos } from '../data/site';

interface Props {
	photos: typeof campPhotos;
	compact?: boolean;
}

const { photos, compact = false } = Astro.props;
---

<div class:list={['camp-gallery', compact && 'camp-gallery--compact']}>
	{
		photos.map((photo) => (
			<figure class="camp-photo">
				<div class="camp-photo__img-wrap" data-reveal-image>
					<img src={photo.src} alt={photo.alt} class="camp-photo__img" loading="lazy" />
				</div>
				<figcaption class="camp-photo__caption">
					<p class="camp-photo__tag">{photo.tag}</p>
					<p class="camp-photo__text">{photo.caption}</p>
				</figcaption>
			</figure>
		))
	}
</div>
