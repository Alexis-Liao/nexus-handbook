---
import type { Locale } from '../../i18n/locales';
import { localizePath, stripLocalePrefix } from '../../i18n/utils';
import { localeLabels, localeSwitcherLabels } from '../../i18n/locales';

interface Props {
	locale: Locale;
	currentPath: string;
}

const { locale, currentPath } = Astro.props;
const labels = localeSwitcherLabels[locale];
const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const switchHref = localizePath(stripLocalePrefix(currentPath), otherLocale);
---

<div class="locale-switcher" role="group" aria-label={locale === 'zh' ? '切换语言' : 'Switch language'}>
	<span class="locale-switcher__current" aria-current="true">{labels[locale]}</span>
	<span class="locale-switcher__sep" aria-hidden="true">/</span>
	<a
		class="locale-switcher__link"
		href={switchHref}
		lang={otherLocale === 'zh' ? 'zh-CN' : 'en'}
		hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'}
		aria-label={localeLabels[otherLocale]}
	>
		{labels[otherLocale]}
	</a>
</div>

<style>
	.locale-switcher {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		padding: 0.35rem 0.65rem;
		border-radius: 0.35rem;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		border: 1px solid var(--nexus-blue-mist);
		background: rgba(255, 255, 255, 0.65);
	}

	.locale-switcher__current {
		color: var(--nexus-blue);
	}

	.locale-switcher__sep {
		color: #a0aec0;
		font-weight: 400;
		user-select: none;
	}

	.locale-switcher__link {
		text-decoration: none;
		color: var(--nexus-ink-soft);
		transition: color 200ms ease;
	}

	.locale-switcher__link:hover {
		color: var(--nexus-blue);
	}

	.site-header--splash .locale-switcher {
		background: rgba(255, 255, 255, 0.72);
	}

	.site-header--splash .locale-switcher__current {
		color: var(--nexus-blue);
	}

	.site-header--splash .locale-switcher__link {
		color: var(--nexus-ink-soft);
	}
</style>
