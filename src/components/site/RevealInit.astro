<script>
	function isInViewport(el) {
		const rect = el.getBoundingClientRect();
		const viewHeight = window.innerHeight || document.documentElement.clientHeight;
		return rect.top < viewHeight * 0.92 && rect.bottom > viewHeight * 0.06;
	}

	function initReveal() {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const targets = document.querySelectorAll('[data-reveal-block], [data-reveal], [data-reveal-stagger]');

		targets.forEach((el) => {
			if (el.dataset.revealBound === 'true') return;
			el.dataset.revealBound = 'true';

			if (reduceMotion || isInViewport(el)) {
				el.classList.add('is-revealed');
				return;
			}

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-revealed');
						observer.unobserve(entry.target);
					});
				},
				{ threshold: 0.08, rootMargin: '0px 0px -4% 0px' },
			);

			observer.observe(el);
		});
	}

	initReveal();
	document.addEventListener('astro:page-load', initReveal);
</script>
