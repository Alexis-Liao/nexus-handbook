---
interface Props {
	eyebrow: string;
	title: string;
	lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
	<div class="site-page-inner" data-reveal-block>
		<p class="page-hero__eyebrow" data-reveal-item>{eyebrow}</p>
		<h1 class="page-hero__title" data-reveal-item>{title}</h1>
		{lede && <p class="page-hero__lede" data-reveal-item>{lede}</p>}
	</div>
</section>
