---
interface Props {
	eyebrow: string;
	title: string;
	lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
	<div class="site-page-inner" data-reveal-block>
		<p class="page-hero__eyebrow" data-reveal-item>
			<span class="reveal-line__inner">{eyebrow}</span>
		</p>
		<h1 class="page-hero__title" data-reveal-item>
			<span class="reveal-line__inner">{title}</span>
		</h1>
		{
			lede && (
				<p class="page-hero__lede" data-reveal-item>
					<span class="reveal-line__inner">{lede}</span>
				</p>
			)
		}
	</div>
</section>
