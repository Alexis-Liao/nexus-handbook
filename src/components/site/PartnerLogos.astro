---
import { partners } from '../../data/site';
---

{
	partners.logos && (
		<div class="partner-logos" aria-label="合作组织标识">
			<img
				src={partners.logos}
				alt=""
				class="partner-logos__img"
				width="1024"
				height="258"
				loading="lazy"
				decoding="async"
			/>
		</div>
	)
}

<style>
	.partner-logos {
		margin: 0 0 clamp(2rem, 5vw, 2.75rem);
		padding: clamp(1.5rem, 4vw, 2rem);
		border: 1px solid var(--nexus-blue-mist);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.72);
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.partner-logos__img {
		display: block;
		width: 100%;
		min-width: 36rem;
		height: auto;
		object-fit: contain;
	}

	@media (max-width: 720px) {
		.partner-logos {
			margin-bottom: 1.75rem;
			padding: 1.15rem 1rem;
		}

		.partner-logos__img {
			min-width: 28rem;
		}
	}
</style>
