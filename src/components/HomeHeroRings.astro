<div class="nexus-hero__canvas nexus-hero__canvas--rings" aria-hidden="true">
	<svg class="nexus-hero__rings" viewBox="0 0 600 600" aria-hidden="true">
		<circle class="nexus-hero__ring nexus-hero__ring--1" cx="300" cy="300" r="240" />
		<circle class="nexus-hero__ring nexus-hero__ring--2" cx="300" cy="300" r="180" />
		<circle class="nexus-hero__ring nexus-hero__ring--3" cx="300" cy="300" r="120" />
		<circle class="nexus-hero__ring nexus-hero__ring--4" cx="300" cy="300" r="60" />
		<g class="nexus-hero__dots">
			{
				[0, 45, 90, 135, 180, 225, 270, 315].map((deg, i) => {
					const rad = (deg * Math.PI) / 180;
					const x = 300 + Math.cos(rad) * 240;
					const y = 300 + Math.sin(rad) * 240;
					return (
						<circle
							class="nexus-hero__dot"
							cx={x}
							cy={y}
							r="5"
							style={`animation-delay: ${i * 0.35}s`}
						/>
					);
				})
			}
		</g>
	</svg>
</div>
