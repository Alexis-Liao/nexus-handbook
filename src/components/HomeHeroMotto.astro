---
import { site } from '../data/site';

const [mottoRight, mottoLeft] = site.motto.split('，');
---

<div class="nexus-hero__canvas nexus-hero__canvas--motto" data-parallax="0.2" aria-hidden="true">
	<div class="nexus-hero__motto">
		<p class="nexus-hero__motto-col">{mottoRight}</p>
		<p class="nexus-hero__motto-col">{mottoLeft}</p>
	</div>
</div>
