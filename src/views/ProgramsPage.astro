---
import type { Locale } from '../i18n/locales';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import SectionHead from '../components/site/SectionHead.astro';
import { getSiteData } from '../data/site';
import { getCampMemories } from '../data/campMemories';
import { getUi } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import CampGallery from '../components/site/CampGallery.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { programs, timeline, sampleCourses, campPhotos } = getSiteData(locale);
const campMemories = getCampMemories(locale);
const t = getUi(locale);
---

<BaseLayout
	title={t.meta.programsTitle}
	description={t.meta.programsDescription}
	currentPath={localizePath('/programs/', locale)}
	locale={locale}
>
	<PageHero eyebrow="Programs" title={t.programs.heroTitle} lede={t.programs.heroLede} />

	<div class="site-docs">
		<section class="site-section">
			<div class="site-page-inner">
				<div class="site-card-grid site-card-grid--cols-3" data-reveal-stagger>
					{
						programs.map((program) => (
							<article class="site-card">
								<p class="site-card__tag">{program.tag}</p>
								<h2 class="site-card__title">{program.title}</h2>
								<p class="site-card__text">{program.description}</p>
								{program.details.length > 0 && (
									<ul class="feature-list">
										{program.details.map((detail) => (
											<li>{detail}</li>
										))}
									</ul>
								)}
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow={t.programs.campLifeEyebrow} title={t.programs.campLifeTitle} intro={t.programs.campLifeIntro} />
				<CampGallery photos={campPhotos} />
			</div>
		</section>

		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow={t.programs.memoriesEyebrow} title={t.programs.memoriesTitle} intro={t.programs.memoriesIntro} />
				<div class="site-card-grid site-card-grid--cols-2" data-reveal-stagger>
					{
						campMemories.map((item) => (
							<a href={localizePath(`/programs/memories/${item.slug}/`, locale)} class="site-card memory-card">
								<p class="site-card__tag">
									{item.kind === 'essay' ? t.programs.memoryEssay : t.programs.memoryReview} · {item.location}
								</p>
								<h2 class="site-card__title">{item.title}</h2>
								<p class="site-card__meta">{item.date}</p>
								<p class="memory-card__subtitle">{item.subtitle}</p>
								<p class="site-card__text">{item.excerpt}</p>
								{
									item.coverImage && (
										<div class="memory-card__thumb">
											<img src={item.coverImage} alt="" loading="lazy" />
										</div>
									)
								}
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				<SectionHead eyebrow={t.programs.timelineEyebrow} title={t.programs.timelineTitle} />
				<div class="timeline-road">
					<svg class="timeline-road__svg" viewBox="0 0 120 720" preserveAspectRatio="none" aria-hidden="true">
						<path
							class="timeline-road__track"
							d="M 60 16 C 60 56, 104 72, 104 128 C 104 184, 16 200, 16 256 C 16 312, 104 328, 104 384 C 104 440, 16 456, 16 512 C 16 568, 104 584, 104 640 C 104 680, 60 696, 60 704"
						></path>
						<path
							class="timeline-road__centerline"
							d="M 60 16 C 60 56, 104 72, 104 128 C 104 184, 16 200, 16 256 C 16 312, 104 328, 104 384 C 104 440, 16 456, 16 512 C 16 568, 104 584, 104 640 C 104 680, 60 696, 60 704"
						></path>
					</svg>
					<ol class="timeline timeline--road" data-reveal-stagger>
						{
							timeline.map((item) => (
								<li class="timeline__item">
									<article class="timeline__card">
										<span class="timeline__period">{item.period}</span>
										<span class="timeline__label">{item.label}</span>
									</article>
									<span class="timeline__node" aria-hidden="true"></span>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow={t.programs.coursesEyebrow} title={t.programs.coursesTitle} intro={t.programs.coursesIntro} />
				<div class="site-card-grid site-card-grid--cols-3" data-reveal-stagger>
					{
						sampleCourses.map((course) => (
							<article class="site-card">
								<h3 class="site-card__title">{course.title}</h3>
								<p class="site-card__meta">
									{t.programs.facilitatorLabel}{course.leader}
									{course.leaderBio && ` · ${course.leaderBio}`}
								</p>
								<p class="site-card__text">{course.description}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
