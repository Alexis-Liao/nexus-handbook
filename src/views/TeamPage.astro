---
import type { Locale } from '../i18n/locales';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import SectionHead from '../components/site/SectionHead.astro';
import TeamMemberCard from '../components/site/TeamMemberCard.astro';
import { getSiteData } from '../data/site';
import { getUi } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { leadership, teamGroups } = getSiteData(locale);
const t = getUi(locale);
---

<BaseLayout
	title={t.meta.teamTitle}
	description={t.meta.teamDescription}
	currentPath={localizePath('/team/', locale)}
	locale={locale}
>
	<PageHero eyebrow="Team" title={t.team.heroTitle} lede={t.team.heroLede} />

	<div class="site-docs">
		<section class="site-section">
			<div class="site-page-inner">
				<SectionHead eyebrow={t.team.leadershipEyebrow} title={t.team.leadershipTitle} />
				<div class="site-card-grid site-card-grid--cols-2" data-reveal-stagger>
					{
						leadership.map((person) => (
							<TeamMemberCard
								name={person.name}
								role={person.role}
								school={'school' in person ? person.school : undefined}
								bio={person.bio}
								photo={'photo' in person ? person.photo : undefined}
								lead
							/>
						))
					}
				</div>
			</div>
		</section>

		<section class="site-section site-section--paper">
			<div class="site-page-inner">
				{
					teamGroups.map((group) => (
						<div class="team-group">
							<h2 class="team-group__title">{group.name}</h2>
							<div class="site-card-grid site-card-grid--cols-3" data-reveal-stagger>
								{group.members.map((member) => (
									<TeamMemberCard
										name={member.name}
										school={'school' in member ? member.school : undefined}
										bio={'bio' in member ? member.bio : undefined}
										photo={'photo' in member ? member.photo : undefined}
									/>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>
