---
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import MotionInit from '../components/site/MotionInit.astro';
import CursorDot from '../components/site/CursorDot.astro';
import { ClientRouter } from 'astro:transitions';
import { getSiteData } from '../data/site';
import { getUi } from '../i18n/ui';
import { LOGO_PATH, SITE_URL } from '../consts';
import {
	getAlternateUrls,
	localizePath,
	type Locale,
} from '../i18n/utils';
import { localeHtmlLang, localeOgLocale } from '../i18n/locales';
import '../styles/site.css';

interface Props {
	title: string;
	description?: string;
	currentPath?: string;
	splash?: boolean;
	locale?: Locale;
}

const {
	title,
	description,
	currentPath = Astro.url.pathname,
	splash = false,
	locale = 'zh',
} = Astro.props;

const siteData = getSiteData(locale);
const t = getUi(locale);
const pageDescription = description ?? siteData.site.description;
const pageTitle =
	title === siteData.site.name
		? `${siteData.site.name} · ${t.meta.titleSuffix}`
		: `${title} · ${siteData.site.name}`;
const canonicalURL = new URL(currentPath, SITE_URL);
const ogImage = new URL(LOGO_PATH, SITE_URL);
const alternates = getAlternateUrls(currentPath);
const navLabels = {
	open: t.nav.openMenu,
	close: t.nav.closeMenu,
};
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="zh-CN" href={alternates.zh} />
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="x-default" href={alternates.zh} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteData.site.name} />
		<meta property="og:locale" content={localeOgLocale[locale]} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<link rel="icon" type="image/png" href={LOGO_PATH} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=Noto+Serif+SC:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<ClientRouter />
	</head>
	<body>
		<div class="site-shell" data-splash={splash || undefined}>
			<SiteHeader currentPath={currentPath} splash={splash} locale={locale} />
			<main class="site-main" transition:animate="fade">
				<slot />
			</main>
			<SiteFooter locale={locale} />
		</div>
		<MotionInit />
		<CursorDot />
		<script define:vars={{ navLabels, locale, homePath: localizePath('/', locale) }}>
			const header = document.querySelector('.site-header');
			const toggle = document.querySelector('.site-nav-toggle');
			const nav = document.querySelector('.site-nav');
			const backdrop = document.querySelector('.site-nav-backdrop');

			function setNavOpen(open) {
				header?.setAttribute('data-open', open ? 'true' : 'false');
				toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle?.setAttribute('aria-label', open ? navLabels.close : navLabels.open);
				backdrop?.setAttribute('aria-hidden', open ? 'false' : 'true');
				document.body.style.overflow = open ? 'hidden' : '';
			}

			toggle?.addEventListener('click', () => {
				const open = header?.getAttribute('data-open') !== 'true';
				setNavOpen(open);
			});

			backdrop?.addEventListener('click', () => setNavOpen(false));

			nav?.querySelectorAll('.site-nav__link').forEach((link) => {
				link.addEventListener('click', () => setNavOpen(false));
			});

			document.addEventListener('click', (event) => {
				if (
					header?.getAttribute('data-open') === 'true' &&
					event.target instanceof Node &&
					!header.contains(event.target)
				) {
					setNavOpen(false);
				}
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setNavOpen(false);
			});

			function syncNavState() {
				const path = window.location.pathname;
				document.querySelectorAll('.site-nav__link').forEach((link) => {
					const href = link.getAttribute('href');
					if (!href) return;
					const active =
						href === homePath
							? path === homePath || path === `${homePath}index.html`
							: path.startsWith(href);
					if (active) link.setAttribute('aria-current', 'page');
					else link.removeAttribute('aria-current');
				});
			}

			function syncSplashState() {
				const isHome = window.location.pathname === homePath || window.location.pathname === `${homePath}index.html`;
				const shell = document.querySelector('.site-shell');
				if (shell) shell.toggleAttribute('data-splash', isHome);
				if (header) header.classList.toggle('site-header--splash', isHome);
			}

			function syncPageState() {
				setNavOpen(false);
				syncSplashState();
				syncNavState();
			}

			syncPageState();
			document.addEventListener('astro:page-load', syncPageState);
		</script>
	</body>
</html>
